{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mksaas-template",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mksaas-db",
      "database_id": "Create a D1 database and put the ID here"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "mksaas-storage",
      "preview_bucket_name": "mksaas-storage-preview"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "Create a KV namespace and put the ID here"
    },
    {
      "binding": "CACHE",
      "id": "Create a KV namespace for general cache and put the ID here"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 100,
          "period": 60
        }
      }
    ]
  },
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://your-domain.com"
  }
}
